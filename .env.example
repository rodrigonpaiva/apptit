# Synthetic local development only. npm run local:env generates private random values.
APP_MODE=synthetic
SEED_MODE=synthetic
BIND_HOST=127.0.0.1
WEB_PORT=3000
GATEWAY_PORT=4000
IDENTITY_PORT=4001
KITCHEN_PORT=4002
WEB_ORIGIN=http://127.0.0.1:3000
POSTGRES_PORT=55432
POSTGRES_ADMIN_PASSWORD=__GENERATE_ADMIN_PASSWORD__
IDENTITY_DB_PASSWORD=__GENERATE_IDENTITY_PASSWORD__
KITCHEN_DB_PASSWORD=__GENERATE_KITCHEN_PASSWORD__
IDENTITY_DATABASE_URL=postgresql://apptit_identity:__GENERATE_IDENTITY_PASSWORD__@127.0.0.1:55432/apptit_identity_synthetic
KITCHEN_DATABASE_URL=postgresql://apptit_kitchen:__GENERATE_KITCHEN_PASSWORD__@127.0.0.1:55432/apptit_kitchen_synthetic
IDENTITY_INTERNAL_TOKEN=__GENERATE_IDENTITY_TOKEN__
KITCHEN_INTERNAL_TOKEN=__GENERATE_KITCHEN_TOKEN__
SESSION_COOKIE_SECRET=__GENERATE_COOKIE_SECRET__
CSRF_SECRET=__GENERATE_CSRF_SECRET__
# Fixture engineering settings only; not approved live restaurant policies.
ALLOW_INSECURE_LOCAL_COOKIES=true
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=60
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
INTERNAL_TIMEOUT_MS=3000
OFF_MODE=fixture
# Explicit read-only live opt-in; never inferred from credentials.
OFF_USER_AGENT=Apptit/0.0.0 (https://github.com/rodrigonpaiva/apptit)
OFF_TIMEOUT_MS=5000
OFF_CACHE_SECONDS=900
AI_MODE=disabled
OCR_MODE=disabled
OFFLINE_MODE=disabled
EVIDENCE_MODE=disabled
NEXT_TELEMETRY_DISABLED=1
NX_DAEMON=false
NX_NO_CLOUD=true
IDENTITY_KITCHEN_TOKEN=__GENERATE_IDENTITY_KITCHEN_TOKEN__
FIXTURE_CHEF_A_PASSWORD=__GENERATE_CHEF_A_PASSWORD__
FIXTURE_STOREKEEPER_A_PASSWORD=__GENERATE_STOREKEEPER_A_PASSWORD__
FIXTURE_COOK_A_PASSWORD=__GENERATE_COOK_A_PASSWORD__
FIXTURE_CHEF_B_PASSWORD=__GENERATE_CHEF_B_PASSWORD__
FIXTURE_MULTI_PASSWORD=__GENERATE_MULTI_PASSWORD__

# Synthetic private images only; required when EVIDENCE_MODE=fixture.
# Set EVIDENCE_ROOT to an absolute private directory outside public/static roots.
EVIDENCE_ROOT=
EVIDENCE_MAX_BYTES=2097152

# Illustrative receiving assessments only; not a validated operational PMS.
OBSERVATION_MODE=disabled
