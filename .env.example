WEB_PORT=3000
GATEWAY_PORT=4000
IDENTITY_PORT=4001
KITCHEN_PORT=4002
WEB_ORIGIN=http://127.0.0.1:3000
POSTGRES_PORT=55432
POSTGRES_ADMIN_PASSWORD=__GENERATE_ADMIN_PASSWORD__
IDENTITY_DB_PASSWORD=__GENERATE_IDENTITY_PASSWORD__
KITCHEN_DB_PASSWORD=__GENERATE_KITCHEN_PASSWORD__
