{
  "name": "apptit",
  "version": "0.0.0",
  "private": true,
  "description": "Synthetic Apptit development foundation",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10.9.7 <11"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "local:env": "node scripts/setup-env.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:reset": "node scripts/infra.mjs reset --confirm-synthetic-reset",
    "db:generate": "node scripts/database.mjs generate",
    "db:validate": "node scripts/database.mjs validate",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "dev": "node scripts/local.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/nx.mjs run-many -t build --outputStyle=static",
    "typecheck": "node scripts/nx.mjs run-many -t typecheck --outputStyle=static",
    "lint": "node scripts/nx.mjs run-many -t lint --outputStyle=static && eslint scripts tests eslint.config.mjs apps/web/next.config.mjs services/*/prisma.config.ts --max-warnings=0",
    "contracts:check": "tsc --strict --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext docs/architecture/contracts/first-slice.ts",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run db:validate && npm run lint && npm run typecheck && npm run contracts:check && npm run test && npm run build",
    "build:backend": "node scripts/nx.mjs run-many -t build --projects=contracts,domain-values,runtime,gateway-api,identity,kitchen --outputStyle=static",
    "pretest": "node scripts/nx.mjs run-many -t build --projects=runtime,domain-values --outputStyle=static",
    "git:setup": "node scripts/setup-git.mjs",
    "test:integration": "node scripts/integration.mjs"
  },
  "devDependencies": {
    "nx": "24.0.4",
    "@nx/js": "24.0.4",
    "@nx/eslint-plugin": "24.0.4",
    "typescript": "5.9.3",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint-config-prettier": "10.1.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1"
  }
}
