generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Synthetic setup marker only. Domain persistence belongs to SP1-03 onward.
model RuntimeFixture {
  id      String @id
  payload Json
}

model IdentityUser {
  id String @id @db.Uuid
  login String @unique @db.VarChar(100)
  name String @db.VarChar(200)
  passwordHash String
  isActive Boolean @default(true)
  memberships SiteMembership[]
  sessions AccessSession[]
}
model Tenant {
  id String @id @db.Uuid
  name String @db.VarChar(200)
  isActive Boolean @default(true)
  sites Site[]
}
model Site {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  name String @db.VarChar(200)
  timeZone String @db.VarChar(100)
  isActive Boolean @default(true)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships SiteMembership[]
  sessions AccessSession[]
  @@index([tenantId])
}
model SiteMembership {
  userId String @db.Uuid
  siteId String @db.Uuid
  role String @db.VarChar(20)
  isActive Boolean @default(true)
  version Int @default(1)
  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  @@id([userId, siteId])
}
model AccessSession {
  id String @id @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId String @db.Uuid
  selectedSiteId String @db.Uuid
  createdAt DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  selectedSite Site @relation(fields: [selectedSiteId], references: [id], onDelete: Restrict)
  @@index([userId])
}
model AccessEvent {
  id String @id @db.Uuid
  sessionId String @db.Uuid
  subjectUserId String @db.Uuid
  actorId String @db.Uuid
  actorName String @db.VarChar(200)
  siteId String @db.Uuid
  kind String @db.VarChar(20)
  recordedAt DateTime @db.Timestamptz(3)
  @@index([sessionId])
}
model LoginRate {
  key String @id @db.VarChar(80)
  startedAt DateTime @db.Timestamptz(3)
  attempts Int
}
