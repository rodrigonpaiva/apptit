{
  "name": "gateway-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gateway-api/src",
  "projectType": "application",
  "tags": [
    "scope:gateway",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b",
        "cwd": "apps/gateway-api"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/gateway-api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings=0",
        "cwd": "apps/gateway-api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/serve.mjs gateway-api",
        "cwd": "apps/gateway-api"
      },
      "cache": false
    }
  }
}
