{
  "name": "identity",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/identity/src",
  "projectType": "application",
  "tags": [
    "scope:identity",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b",
        "cwd": "services/identity"
      },
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "services/identity"
      },
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings=0",
        "cwd": "services/identity"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/database.mjs generate identity",
        "cwd": "services/identity"
      },
      "cache": false
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/serve.mjs identity",
        "cwd": "services/identity"
      },
      "cache": false
    }
  }
}
