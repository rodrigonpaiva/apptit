KITCHEN_DATABASE_URL=postgresql://apptit_kitchen:__GENERATE_KITCHEN_PASSWORD__@127.0.0.1:55432/apptit_kitchen_synthetic
IDENTITY_INTERNAL_TOKEN=__GENERATE_IDENTITY_TOKEN__
KITCHEN_INTERNAL_TOKEN=__GENERATE_KITCHEN_TOKEN__
SESSION_COOKIE_SECRET=__GENERATE_COOKIE_SECRET__
