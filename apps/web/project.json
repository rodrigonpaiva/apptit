{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [
    "scope:web",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build --webpack",
        "cwd": "apps/web"
      },
      "outputs": [
        "{projectRoot}/.next"
      ],
      "cache": true,
      "inputs": [
        "default",
        {
          "env": "GATEWAY_PORT"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next typegen && tsc --noEmit",
        "cwd": "apps/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --max-warnings=0",
        "cwd": "apps/web"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/serve.mjs web",
        "cwd": "apps/web"
      },
      "cache": false
    }
  }
}
